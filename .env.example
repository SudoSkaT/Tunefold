# Copia este archivo a `.env` y ajusta los valores.
# Ningún secreto debe ir al repositorio.
# La TUI también puede editar estos ajustes (vista Settings, Ctrl+7) y
# guardarlos de vuelta aquí.

# Reproductor usado al reproducir:
#   auto   -> elige según la fuente (YouTube usa el motor local rodio)
#   rodio  -> fuerza el motor de audio local (default)
PLAYBACK_POLICY=auto

# Feature flags (spec): apagables sin recompilar. Valores: 1/true/on | 0/false/off
# YOUTUBE_PROVIDER_ENABLED=1        # provider de YouTube/YouTube Music
# OFFICIAL_PROVIDER_ENABLED=0       # reservado para proveedores oficiales futuros
# ALTERNATE_PROVIDER_ENABLED=0      # reservado para fuentes alternativas futuras
# PROXY_ENABLED=1                   # respetar HTTP_PROXY/HTTPS_PROXY del entorno
# AUDIO_ANALYSIS_ENABLED=1          # pipeline de análisis de audio (Fase 6)
# ADVANCED_VISUALIZATION_ENABLED=1  # visualización avanzada (Fase 7)

# Transporte: tamaño de ventana de descarga por rangos HTTP, en KiB.
# Default 512; rango válido 32–4096. Solo tocar si la red lo justifica.
# Se acepta el alias legacy PLAYFUSION_RANGE_WINDOW_KIB.
# TUNEFOLD_RANGE_WINDOW_KIB=512