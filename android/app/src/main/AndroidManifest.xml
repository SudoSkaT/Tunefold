<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- System media controls: notification actions and lock-screen transport (§17). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:label="Tunefold"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">
        <!--
            The screen owns its whole tree and re-derives it from the window, so a
            configuration change is a re-measure and not a rebuild. `orientation`,
            `screenSize` and `keyboardHidden` were already declared; the rest are here
            because each one used to cost a full Activity recreation — the window,
            the decor, the pooled rows, the decoded cover and the service binding —
            for something this Activity can absorb on its own:

              uiMode            the app is dark by design and has two themes, not one
              fontScale         tokens are re-read in onConfigurationChanged
              density           so are the pixel conversions
              screenLayout      a phone becoming a tablet, e.g. unfolding
              smallestScreenSize the same, in the other direction

            A recreation would also throw away the mini player's identity for nothing:
            it is fed by a snapshot and keeps no state of its own, but rebuilding it
            is not free, and "the strip disappeared" is the kind of bug that only
            reproduces on the device that folds.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale|density"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Los controles sobre la pantalla de bloqueo. Se abre desde la notificación,
            no desde la app, así que va marcada como `excludeFromRecents`: aparecer en
            "Aplicaciones recientes" al lado de Tunefold y no hacer nada al tocarla
            desde allí sería una pantalla fantasma.

            `showOnLockScreen` + `turnScreenOn=false` son el camino que Android admite
            para esto: la actividad se coloca encima del candado y, al bloquear de
            nuevo, el sistema la retira sola. No hay ninguna ventana legítima que
            pueda dibujar sobre la pantalla de bloqueo.
        -->
        <activity
            android:name=".LockScreenControlsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <service
            android:name=".ForegroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
